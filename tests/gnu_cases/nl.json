        "xx"
      ],
      "stdin": "a\n",
      "compare": [
        "stdout",
        "exit"
      ]
    },
    {
      "name": "missing_file_continues",
      "args": [
        "nope.txt",
        "a.txt"
      ],
      "files": {
        "a.txt": "a\nb\n"
      },
      "compare": [
        "stdout",
        "exit"
      ]
    },
    {
      "name": "negative_start",
      "args": [
        "-v",
        "-5"
      ],
      "stdin": "a\nb\n"
    },
    {
      "name": "multiple_files_continue_numbering",
      "args": [
        "-ba",
