        "a"
      ],
      "stdin": "\\:\\:\\:\nh1\nh2\n\\:\\:\nb1\nb2\n\\:\nf1\n"
    },
    {
      "name": "regex_body_style",
      "args": [
        "-b",
        "pb"
      ],
      "stdin": "abc\nxyz\nbbb\n"
    },
    {
      "name": "join_blank_lines",
      "args": [
        "-ba",
        "-l",
        "2"
      ],
      "stdin": "a\n\n\n\nb\n"
