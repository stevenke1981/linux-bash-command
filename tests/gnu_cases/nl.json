    {
      "name": "pages_default",
      "args": [],
      "stdin": "\\:\\:\\:\nh1\n\\:\\:\nb1\n\\:\nf1\n"
    },
    {
      "name": "pages_header_footer_all",
      "args": [
        "-h",
        "a",
