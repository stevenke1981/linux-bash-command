  "cases": [
    {
      "name": "default_numbering",
      "args": [],
      "stdin": "one\n\ntwo\n"
    },
    {
      "name": "body_all_lines",
      "args": [
        "-ba"
      ],
      "stdin": "one\n\ntwo\n"
    },
    {
      "name": "body_none",
      "args": [
        "-bn"
      ],
      "stdin": "one\ntwo\n"
    },
    {
      "name": "format_rz",
      "args": [
        "-n",
        "rz"
      ],
      "stdin": "one\ntwo\n"
