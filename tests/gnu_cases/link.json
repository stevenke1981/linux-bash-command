{
  "command": "link",
  "cases": [
    { "name": "creates_hard_link", "args": ["a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "missing_operand", "args": [], "compare": ["stdout", "exit", "files"] },
    { "name": "one_operand_missing_second", "args": ["a"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "extra_operand_is_error", "args": ["a", "b", "c"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "existing_destination_is_error", "args": ["a", "b"], "files": { "a": "x\n", "b": "y\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "missing_source_is_error", "args": ["nope", "x"], "compare": ["stdout", "exit", "files"] },
    { "name": "directory_source_is_error", "args": ["d", "e"], "files": { "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "unknown_option_is_error", "args": ["-x", "a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "destination_in_other_directory", "args": ["a", "d/h"], "files": { "a": "x\n", "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "double_dash_then_dash_names", "args": ["--", "-x", "y"], "files": { "-x": "q\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "link_to_symlink_is_hard_link_to_link", "args": ["l", "m"], "files": { "t": "x\n", "l": { "symlink": "t" } }, "compare": ["stdout", "exit", "files"] },
    { "name": "missing_destination_directory_is_error", "args": ["a", "nodir/x"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "double_dash_alone_is_missing_operand", "args": ["--"], "compare": ["stdout", "exit", "files"] },
    { "name": "same_name_is_error", "args": ["a", "a"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "two_operands_in_subdirectory", "args": ["d/a", "d/b"], "files": { "d/a": "x\n" }, "compare": ["stdout", "exit", "files"] }
  ]
}
