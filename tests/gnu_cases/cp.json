{
  "command": "cp",
  "cases": [
    { "name": "file_to_new_name", "args": ["a", "b"], "files": { "a": "hello\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "file_into_directory", "args": ["a", "d"], "files": { "a": "x\n", "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "multiple_into_directory", "args": ["a", "b", "d"], "files": { "a": "1\n", "b": "2\n", "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "missing_source_is_error", "args": ["nope", "x"], "compare": ["stdout", "exit", "files"] },
    { "name": "missing_destination_operand", "args": ["a"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "no_operand_is_error", "args": [], "compare": ["stdout", "exit", "files"] },
    { "name": "directory_needs_recursive", "args": ["d", "e"], "files": { "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "recursive_copies_tree", "args": ["-r", "d", "e"], "files": { "d": { "dir": true }, "d/f": "x\n", "d/s": { "dir": true }, "d/s/g": "yy\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "recursive_into_existing_dir", "args": ["-R", "d", "e"], "files": { "d": { "dir": true }, "d/f": "x\n", "e": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "verbose_file", "args": ["-v", "a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "verbose_recursive_single_child", "args": ["-rv", "d", "e"], "files": { "d": { "dir": true }, "d/f": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "no_clobber_keeps_destination", "args": ["-n", "a", "b"], "files": { "a": "new\n", "b": "old\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "interactive_answer_no", "args": ["-i", "a", "b"], "stdin": "n\n", "files": { "a": "new\n", "b": "old\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "interactive_answer_yes", "args": ["-i", "a", "b"], "stdin": "y\n", "files": { "a": "new\n", "b": "old\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "backup_simple_tilde", "args": ["-b", "a", "b"], "files": { "a": "new\n", "b": "old\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "backup_numbered", "args": ["--backup=numbered", "a", "b"], "files": { "a": "new\n", "b": "old\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "backup_custom_suffix", "args": ["-b", "-S", ".bak", "a", "b"], "files": { "a": "new\n", "b": "old\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "update_older_keeps_newer_destination", "args": ["-u", "a", "b"], "files": { "a": { "text": "src\n", "mtime": 1600000000 }, "b": { "text": "dst\n", "mtime": 1700000000 } }, "compare": ["stdout", "exit", "files"] },
    { "name": "update_older_copies_newer_source", "args": ["-u", "a", "b"], "files": { "a": { "text": "src\n", "mtime": 1700000000 }, "b": { "text": "dst\n", "mtime": 1600000000 } }, "compare": ["stdout", "exit", "files"] },
    { "name": "no_dereference_copies_link", "args": ["-P", "l", "l2"], "files": { "t": "x\n", "l": { "symlink": "t" } }, "compare": ["stdout", "exit", "files"] },
    { "name": "dereference_copies_contents", "args": ["-L", "l", "l2"], "files": { "t": "x\n", "l": { "symlink": "t" } }, "compare": ["stdout", "exit", "files"] },
    { "name": "hard_link_mode", "args": ["-l", "a", "h"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "preserve_mode_and_times", "args": ["-p", "a", "b"], "files": { "a": { "text": "x\n", "mode": "600", "mtime": 1600000000 } }, "compare": ["stdout", "exit", "files"] },
    { "name": "archive_directory_tree", "args": ["-a", "d", "e"], "files": { "d": { "dir": true }, "d/f": "x\n", "d/t": { "symlink": "f" } }, "compare": ["stdout", "exit", "files"] },
    { "name": "same_file_is_error", "args": ["a", "a"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "directory_into_itself_is_error", "args": ["-r", "d", "d/sub"], "files": { "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "target_directory_option", "args": ["-t", "d", "a", "b"], "files": { "a": "1\n", "b": "2\n", "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "no_target_directory_option", "args": ["-T", "a", "b"], "files": { "a": "1\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "no_target_onto_directory_is_error", "args": ["-T", "a", "d"], "files": { "a": "1\n", "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "parents_keeps_source_path", "args": ["--parents", "src/deep/f", "dst"], "files": { "src/deep/f": "q\n", "dst": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "multiple_to_missing_target_is_error", "args": ["a", "b", "c"], "files": { "a": "1\n", "b": "2\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "remove_destination_replaces_link", "args": ["--remove-destination", "a", "b"], "files": { "a": "new\n", "b": { "symlink": "a" } }, "compare": ["stdout", "exit", "files"] },
    { "name": "missing_source_in_list_continues", "args": ["nope", "a", "d"], "files": { "a": "1\n", "d": { "dir": true } }, "compare": ["stdout", "exit", "files"] },
    { "name": "sparse_never_accepted", "args": ["--sparse=never", "a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "sparse_bogus_is_error", "args": ["--sparse=bogus", "a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"] },
    { "name": "reflink_always_unsupported", "args": ["--reflink=always", "a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"], "skip_reason": "agentcmd: --reflink=always is not supported (no clone support, spec 03 cp)" },
    { "name": "attributes_only_unsupported", "args": ["--attributes-only", "a", "b"], "files": { "a": "x\n" }, "compare": ["stdout", "exit", "files"], "skip_reason": "agentcmd: --attributes-only is not supported (spec 03 cp)" }
  ]
}
