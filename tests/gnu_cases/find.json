      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "parens_or_precedence",
      "args": [".", "(", "-name", "*.txt", "-o", "-name", "*.md", ")", "-type", "f"],
      "files": { "a.txt": "a\n", "b.md": "b\n", "c.log": "c\n", "sub/d.txt": "d\n" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "exec_echo_each",
      "args": [".", "-name", "*.txt", "-exec", "echo", "found:{}", ";"],
      "files": { "a.txt": "a\n", "sub/b.txt": "b\n" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "exec_echo_batch",
      "args": [".", "-name", "*.txt", "-exec", "echo", "{}", "+"],
      "files": { "a.md": "a\n", "sub/b.txt": "b\n" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "printf_name_and_size",
      "args": [".", "-type", "f", "-printf", "%p %s\\n"],
      "files": { "a.txt": "abcd", "sub/b.txt": "xy" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "delete_matching_files",
      "args": [".", "-name", "*.tmp", "-delete"],
      "files": { "keep.txt": "k\n", "junk.tmp": "j\n", "sub/more.tmp": "m\n" },
      "compare": ["stdout", "exit", "files"]
    },
    {
      "name": "ls_action_skipped_owner_columns",
      "args": [".", "-maxdepth", "1", "-type", "f", "-ls"],
      "files": { "a.txt": { "text": "a\n", "mtime": 1700000000 } },
      "compare": ["stdout_sorted", "exit"],
