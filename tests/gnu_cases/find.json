      "args": [],
      "files": {
        "a.txt": "a\n",
        "b.md": "b\n",
        "sub/c.txt": "c\n",
        "sub/deep/d.txt": "d\n"
      },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "name_glob",
      "args": [".", "-name", "*.txt"],
      "files": {
        "a.txt": "a\n",
        "b.md": "b\n",
        "sub/c.txt": "c\n",
        "sub/deep/d.txt": "d\n"
      },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "type_directory_only",
      "args": [".", "-type", "d"],
