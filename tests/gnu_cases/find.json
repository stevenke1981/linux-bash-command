      },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "empty_files_and_dirs",
      "args": [".", "-empty"],
      "files": { "empty.txt": "", "full.txt": "x\n", "emptydir/.keep": "" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "size_nonzero_bytes",
      "args": [".", "-type", "f", "-size", "+0c"],
      "files": { "zero.txt": "", "one.txt": "x", "three.txt": "abc" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "regex_whole_path",
      "args": [".", "-regex", "./.*\\.md"],
