        "a.txt": "a\n",
        "b.md": "b\n",
        "sub/c.txt": "c\n",
        "sub/deep/d.txt": "d\n"
      },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "name_glob",
      "args": [".", "-name", "*.txt"],
      "files": {
        "a.txt": "a\n",
        "b.md": "b\n",
        "sub/c.txt": "c\n",
        "sub/deep/d.txt": "d\n"
      },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "type_directory_only",
      "args": [".", "-type", "d"],
      "files": { "a.txt": "a\n", "sub/c.txt": "c\n", "sub/deep/d.txt": "d\n" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "maxdepth_one",
      "args": [".", "-maxdepth", "1"],
      "files": { "a.txt": "a\n", "sub/c.txt": "c\n", "sub/deep/d.txt": "d\n" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "mindepth_two_files_only",
      "args": [".", "-mindepth", "2", "-type", "f"],
      "files": { "a.txt": "a\n", "sub/c.txt": "c\n", "sub/deep/d.txt": "d\n" },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "iname_case_insensitive",
      "args": [".", "-iname", "readme*"],
