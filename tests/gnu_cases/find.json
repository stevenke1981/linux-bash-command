      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "newer_than_reference",
      "args": [".", "-type", "f", "-newer", "ref.txt"],
      "files": {
        "ref.txt": { "text": "ref\n", "mtime": 1700000000 },
        "newer.txt": { "text": "n\n", "mtime": 1800000000 },
        "older.txt": { "text": "o\n", "mtime": 1600000000 }
      },
      "compare": ["stdout_sorted", "exit"]
    },
    {
      "name": "perm_exact_mode",
      "args": [".", "-type", "f", "-perm", "600"],
      "files": {
        "secret.txt": { "text": "s\n", "mode": "600" },
